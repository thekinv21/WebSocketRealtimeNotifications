{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint && steiger ./src",
		"lint:fix": "eslint --fix && steiger ./src --fix",
		"lint:fsd": "steiger ./src",
		"format": "prettier --write \"{app,src}/**/*.{ts,tsx}\" steiger.config.ts",
		"format:check": "prettier --check \"{app,src}/**/*.{ts,tsx}\"",
		"prepare": "cd .. && husky frontend/.husky"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.9.1",
		"@tanstack/react-query": "^5.104.1",
		"axios": "^1.20.0",
		"framer-motion": "^14.0.0",
		"lucide-react": "^1.53.0",
		"next": "16.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-hook-form": "^7.89.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@feature-sliced/steiger-plugin": "^0.8.0",
		"@tailwindcss/turbopack": "^4",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.4.0",
		"eslint-plugin-boundaries": "^7.2.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.9",
		"steiger": "^0.7.0",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"packageManager": "bun@1.4.0",
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	]
}
