if git diff --cached --name-only | grep -q '^backend/'; then
  echo "▶ backend checks"
  (
    cd backend || exit 1

    bun run format:check || {
      echo "Backend format check failed. Run: cd backend && bun run format"
      exit 1
    }

    bun run lint || {
      echo "Backend lint failed. Fix the errors above."
      exit 1
    }
  ) || exit 1
fi

# git allows a single hooks dir, so also run the frontend hook (once)
if [ -z "$HUSKY_SIBLING" ] && [ -f frontend/.husky/pre-commit ]; then
  HUSKY_SIBLING=1 sh frontend/.husky/pre-commit "$@" || exit 1
fi
