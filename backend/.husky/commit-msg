MSG_FILE="$1"
HEADER=$(head -n 1 "$MSG_FILE")

PATTERN='^(feat|fix|chore|docs|ci|test|refactor):\[[^][:space:]]+\]\[[^][]+\]: .+$'

if ! printf '%s' "$HEADER" | grep -Eq "$PATTERN"; then
  echo "Invalid commit message."
  echo "Expected: type:[branchName][developerName]: description"
  echo "Example: feat:[master][Vadim]: add authentication"
  exit 1
fi

# git allows a single hooks dir, so also run the frontend hook (once)
if [ -z "$HUSKY_SIBLING" ] && [ -f frontend/.husky/commit-msg ]; then
  HUSKY_SIBLING=1 sh frontend/.husky/commit-msg "$@" || exit 1
fi
